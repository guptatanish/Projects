APP_NAME=ai-chat-bot-backend
ENVIRONMENT=development
API_V1_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=

# Neon PostgreSQL pooled connection string with SSL enabled
DATABASE_URL=postgresql+psycopg://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Google GenAI SDK key and externalized model identifiers
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT_SECONDS=30.0

# Auth & HttpOnly cookie settings (generate a >=32-char random secret for production)
JWT_SECRET_KEY=dev-only-change-me-in-production-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_NAME=ai_chat_bot_session
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=

# History windowing & rate limits
HISTORY_MESSAGE_LIMIT=20
HISTORY_MAX_CHARS=16000
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=300
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_PER_DAY=100
