APP_NAME=ai-chat-bot-backend
APP_ENV=development
ENVIRONMENT=development
API_V1_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Neon PostgreSQL pooled connection string with SSL enabled
DATABASE_URL=postgresql+psycopg://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Google GenAI SDK key and externalized model identifiers
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768